# Optional versioned root containing manifest.json and binary routing cells.
# Leave unset to use GeoAdmin in development and production.
VITE_ROUTING_DATA_BASE_URL=https://data.example.org/swisstlm3d-YYYY/format-v3/ch

# Public endpoint of the temporary GPX sharing Worker.
VITE_SWISSTOPO_SHARE_SERVICE_URL=https://share.example.org

# Optional static public-transport stop catalog.
# Use a root-relative local file during development or an immutable published R2 URL.
# Leave unset to keep the GeoAdmin identify provider.
VITE_PUBLIC_TRANSPORT_STOPS_CATALOG_URL=
